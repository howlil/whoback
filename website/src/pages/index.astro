---
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/Logo.astro';
import { PageInteractions } from '../components/PageInteractions';
import {
  ArrowDown,
  ArrowLeftRight,
  ArrowRight,
  ArrowUp,
  Code2,
  Download,
  HardDrive,
  KeyRound,
  LogIn,
  ServerOff,
} from 'lucide-react';

const releaseUrl = 'https://github.com/howlil/whoback/releases/latest';
const repoUrl = 'https://github.com/howlil/whoback';
const avatarImages = {
  alex: 'https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&w=96&q=82',
  nara: 'https://images.unsplash.com/photo-1494790108377-be9c29b29330?auto=format&fit=crop&w=96&q=82',
  mika: 'https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?auto=format&fit=crop&w=96&q=82',
  maya: 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=96&q=82',
  rian: 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=96&q=82',
  sarah: 'https://images.unsplash.com/photo-1544005313-94ddf0286df2?auto=format&fit=crop&w=96&q=82',
};
---

<BaseLayout>
  <PageInteractions client:load />

  <header class="floating-header">
    <div class="compact-nav">
      <Logo />
      <nav class="hidden items-center gap-5 text-[14px] font-semibold text-muted md:flex" aria-label="Primary">
        <a href="#product">Product</a>
        <a href="#how">How it works</a>
        <a href="#privacy">Privacy</a>
        <a href={repoUrl} target="_blank" rel="noreferrer"><Code2 size={15} strokeWidth={1.8} aria-hidden="true" />GitHub</a>
      </nav>
      <div class="nav-actions">
        <a class="nav-cta" href={releaseUrl} target="_blank" rel="noreferrer">
          Get WhoBack <Download class="nav-cta__icon" size={16} strokeWidth={1.8} aria-hidden="true" />
        </a>
      </div>
    </div>
  </header>

  <main class="site-content">
    <section class="reference-hero">
      <div class="page-shell">
        <div class="hero-copy">
          <h1>
            Did they come <mark>back?</mark>
          </h1>
          <p>
            See who follows you back, who doesn&apos;t, and keep your circle clear — privately in your browser.
          </p>
          <div class="hero-actions">
            <a class="primary-cta" href={releaseUrl} target="_blank" rel="noreferrer">
              Get WhoBack <span class="cta-icon" aria-hidden="true"><ArrowRight size={17} strokeWidth={1.8} /></span>
            </a>
          </div>
        </div>

        <div class="hero-trust" aria-label="WhoBack benefits">
          <span>Works in your browser</span>
          <span>Your data stays local</span>
          <span>No account needed</span>
        </div>

      </div>
    </section>

    <section id="product" class="feature-showcase-section" data-reveal>
      <div class="page-shell">
        <div class="showcase-heading">
          <p class="section-kicker">Product features</p>
          <h2>The relationship views that <mark>matter.</mark></h2>
          <p>See who follows back, who doesn&apos;t, and what changed since your last scan.</p>
        </div>

        <div class="feature-board">
          <article class="feature-tile feature-tile--not-back">
            <div class="feature-tile__eyebrow">
              Doesn&apos;t follow back
            </div>

            <div class="feature-stat-group">
              <div class="feature-stat feature-stat--danger" data-count="128">128</div>
              <div class="feature-stat-caption">accounts you follow</div>
            </div>
            <p class="feature-tile__hint">You follow them. They don&apos;t follow you back.</p>

            <div class="feature-list-preview" aria-hidden="true">
              <div class="feature-user-row">
                <span class="feature-avatar"><img src={avatarImages.alex} alt="" loading="lazy" /></span>
                <span><strong>@alex</strong></span>
                <em>Doesn&apos;t follow back</em>
              </div>
              <div class="feature-user-row">
                <span class="feature-avatar"><img src={avatarImages.nara} alt="" loading="lazy" /></span>
                <span><strong>@nara</strong></span>
                <em>Doesn&apos;t follow back</em>
              </div>
              <div class="feature-user-row feature-user-row--muted">
                <span class="feature-avatar"><img src={avatarImages.mika} alt="" loading="lazy" /></span>
                <span><strong>@mika</strong></span>
                <em>Doesn&apos;t follow back</em>
              </div>
            </div>

          </article>

          <article class="feature-tile feature-tile--mutual">
            <div class="feature-tile__eyebrow">
              Mutual
            </div>
            <div class="feature-stat feature-stat--positive" data-count="603">603</div>
            <div class="feature-stat-caption">mutual accounts</div>
            <div class="feature-connection" aria-hidden="true">
              <span><img src={avatarImages.nara} alt="" loading="lazy" /></span><ArrowLeftRight size={27} strokeWidth={1.7} aria-hidden="true" /><span><img src={avatarImages.rian} alt="" loading="lazy" /></span>
            </div>
            <p class="feature-connection-caption">You follow each other.</p>
            <div class="feature-mini-avatars" aria-hidden="true">
              <span><img src={avatarImages.nara} alt="" loading="lazy" /></span>
              <span><img src={avatarImages.rian} alt="" loading="lazy" /></span>
              <span><img src={avatarImages.mika} alt="" loading="lazy" /></span>
              <em>+599</em>
            </div>
          </article>

          <article class="feature-tile feature-tile--fans">
            <div class="feature-tile__eyebrow">
              You don&apos;t follow back
            </div>
            <div>
              <div class="feature-stat feature-stat--warn" data-count="92">92</div>
              <div class="feature-stat-caption">accounts following you</div>
            </div>
            <p class="feature-tile__hint">They follow you. You don&apos;t follow them back.</p>
            <div class="feature-list-preview" aria-hidden="true">
              <div class="feature-user-row">
                <span class="feature-avatar"><img src={avatarImages.maya} alt="" loading="lazy" /></span>
                <span><strong>@maya</strong></span>
                <em>Follows you</em>
              </div>
              <div class="feature-user-row">
                <span class="feature-avatar"><img src={avatarImages.rian} alt="" loading="lazy" /></span>
                <span><strong>@rian</strong></span>
                <em>Follows you</em>
              </div>
              <div class="feature-user-row feature-user-row--muted">
                <span class="feature-avatar"><img src={avatarImages.sarah} alt="" loading="lazy" /></span>
                <span><strong>@sarah</strong></span>
                <em>Follows you</em>
              </div>
            </div>
          </article>

        </div>

        <div class="feature-scan-summary">
          <div class="feature-scan-summary__heading">
            <span></span>
            <strong>Since your last scan</strong>
            <span></span>
          </div>
          <div class="feature-scan-summary__metrics">
            <div class="feature-scan-metric feature-scan-metric--positive">
              <strong><ArrowUp size={28} strokeWidth={1.8} aria-hidden="true" /> +12</strong>
              <small>New followers</small>
            </div>
            <div class="feature-scan-metric feature-scan-metric--danger">
              <strong><ArrowDown size={28} strokeWidth={1.8} aria-hidden="true" /> −7</strong>
              <small>People who unfollowed you</small>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="how" class="workflow-section" data-reveal>
      <div class="page-shell">
        <div class="workflow-heading">
          <h2>Check your follow relationships in <mark>3 simple steps</mark></h2>
          <p>Keep Instagram open, run WhoBack, then review the result.</p>
        </div>

        <div class="workflow-cards">
          <article class="workflow-card">
            <div class="workflow-visual workflow-visual--instagram">
              <div class="browser-mini">
                <div class="browser-mini__bar"><span></span><span></span><span></span><b>instagram.com</b></div>
                <div class="browser-mini__body">
                  <div class="ig-avatar">Y</div>
                  <div><strong>@youraccount</strong><small>Signed in</small></div>
                  <span class="connected-pill">Connected</span>
                </div>
              </div>
            </div>
            <div class="workflow-card__copy">
              <h3>Open Instagram</h3>
              <p>Stay signed in to instagram.com in Chrome.</p>
            </div>
          </article>

          <article class="workflow-card">
            <div class="workflow-visual workflow-visual--scan">
              <div class="scan-mini">
                <div class="scan-mini__header"><strong>WhoBack</strong><span>Scanning</span></div>
                <div class="scan-mini__row"><span>Following</span><strong>616</strong></div>
                <div class="scan-mini__progress"><span></span></div>
                <span class="scan-mini__button" aria-hidden="true">Check now</span>
              </div>
            </div>
            <div class="workflow-card__copy">
              <h3>Run WhoBack</h3>
              <p>Open the extension and start a check.</p>
            </div>
          </article>

          <article class="workflow-card">
            <div class="workflow-visual workflow-visual--result">
              <div class="result-mini">
                <div><span>Mutual</span><strong class="result-mini__positive">603</strong></div>
                <div><span>Don&apos;t follow back</span><strong class="result-mini__danger">13</strong></div>
                <div><span>You don&apos;t follow back</span><strong class="result-mini__warn">828</strong></div>
              </div>
            </div>
            <div class="workflow-card__copy">
              <h3>View the result</h3>
              <p>See mutual and one-way relationships together.</p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section id="privacy" class="privacy-showcase-section" data-reveal>
      <div class="page-shell">
        <div class="privacy-heading">
          <h2>What stays in your browser.</h2>
          <p>Use your existing Instagram session. Keep scan progress and results local.</p>
        </div>

        <div class="privacy-ledger">
          <article class="privacy-ledger__item">
            <span class="privacy-ledger__icon" aria-hidden="true"><KeyRound size={20} strokeWidth={1.8} /></span>
            <div>
              <h3>No password form</h3>
              <p>WhoBack never asks for your Instagram password.</p>
            </div>
          </article>
          <article class="privacy-ledger__item">
            <span class="privacy-ledger__icon" aria-hidden="true"><LogIn size={20} strokeWidth={1.8} /></span>
            <div>
              <h3>Use your Instagram session</h3>
              <p>The check runs from the Instagram session already open in Chrome.</p>
            </div>
          </article>
          <article class="privacy-ledger__item">
            <span class="privacy-ledger__icon" aria-hidden="true"><ServerOff size={20} strokeWidth={1.8} /></span>
            <div>
              <h3>No WhoBack server</h3>
              <p>Relationship results do not pass through a WhoBack server.</p>
            </div>
          </article>
          <article class="privacy-ledger__item">
            <span class="privacy-ledger__icon" aria-hidden="true"><HardDrive size={20} strokeWidth={1.8} /></span>
            <div>
              <h3>Results stay local</h3>
              <p>Progress and relationship snapshots stay in this browser.</p>
            </div>
          </article>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer" data-reveal>
    <div class="page-shell">
      <section class="footer-cta">
        <div>
          <h2>Check who follows back.<br />Keep your Instagram session in your browser.</h2>
          <p>Download the release ZIP, extract it, then choose Load unpacked in <code>chrome://extensions</code>.</p>
        </div>
        <div class="footer-cta__actions">
          <a class="footer-primary-cta" href={releaseUrl} target="_blank" rel="noreferrer">
            Get WhoBack <span aria-hidden="true"><ArrowRight size={16} strokeWidth={1.8} /></span>
          </a>
        </div>
      </section>

      <div class="footer-grid">
        <div class="footer-brand">
          <Logo />
          <p>A small local-first Chrome extension for checking Instagram follow relationships without handing your password to another service.</p>
        </div>

        <nav class="footer-column" aria-label="Product">
          <strong>Product</strong>
          <a href="#product">Features</a>
          <a href="#how">How it works</a>
          <a href="#privacy">Privacy</a>
        </nav>

        <nav class="footer-column" aria-label="Project">
          <strong>Project</strong>
          <a href={repoUrl} target="_blank" rel="noreferrer">GitHub</a>
          <a href={releaseUrl} target="_blank" rel="noreferrer">Releases</a>
          <a href={repoUrl + '/blob/master/README.md'} target="_blank" rel="noreferrer">README</a>
        </nav>

        <div class="footer-install">
          <strong>Install manually</strong>
          <p>Download the ZIP, extract it, turn on Developer mode, then choose Load unpacked.</p>
          <code>chrome://extensions</code>
        </div>
      </div>

      <div class="footer-bottom">
        <span>WhoBack · open source</span>
        <span>Independent project · not affiliated with Instagram or Meta</span>
      </div>
    </div>
  </footer>

</BaseLayout>
