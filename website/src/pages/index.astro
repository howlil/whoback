---
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/Logo.astro';
import { ProductPreview } from '../components/ProductPreview';

const releaseUrl = 'https://github.com/howlil/whoback/releases/latest';
const repoUrl = 'https://github.com/howlil/whoback';

const outcomes = [
  ["Don't follow you back", 'See people you follow who do not follow you back.'],
  ['Mutual', 'See the people who follow you back.'],
  ["You don't follow back", 'Available when a full follower scan is completed.'],
];

const steps = [
  ['Open Instagram', 'Stay signed in to instagram.com in Chrome.'],
  ['Run WhoBack', 'The extension reads relationship data from that browser session.'],
  ['Inspect the result', 'Review mutuals, one-way follows, and saved scan progress.'],
];
---

<BaseLayout>
  <header class="floating-header">
    <div class="compact-nav">
      <Logo />
      <nav class="hidden items-center gap-5 text-[12px] font-medium text-muted md:flex" aria-label="Primary">
        <a href="#product">Product</a>
        <a href="#how">How it works</a>
        <a href="#privacy">Privacy</a>
        <a href={repoUrl} target="_blank" rel="noreferrer">GitHub</a>
      </nav>
      <a class="nav-cta" href={releaseUrl} target="_blank" rel="noreferrer">Get v1.1</a>
    </div>
  </header>

  <main>
    <section class="reference-hero">
      <div class="page-shell">
        <div class="announcement">
          <span>New</span>
          <p>v1.1 adds adaptive scans and recoverable resume</p>
          <span aria-hidden="true">→</span>
        </div>

        <div class="hero-copy">
          <h1>
            See who <mark>follows you back</mark><br />
            without handing over your password.
          </h1>
          <p>
            WhoBack is a local-first Chrome extension that checks Instagram relationships from the session already open in your browser.
          </p>
          <div class="hero-actions">
            <a class="primary-cta" href={releaseUrl} target="_blank" rel="noreferrer">Download v1.1</a>
            <a class="secondary-cta" href={repoUrl} target="_blank" rel="noreferrer">View source</a>
          </div>
        </div>

        <ProductPreview client:load />
      </div>
    </section>

    <section class="proof-strip">
      <div class="page-shell proof-strip__inner">
        <div><strong>No password form</strong><span>Uses your existing Instagram session.</span></div>
        <div><strong>No WhoBack backend</strong><span>Results and checkpoints stay local.</span></div>
        <div><strong>No restart from page one</strong><span>Recoverable interruptions can resume.</span></div>
      </div>
    </section>

    <section id="product" class="content-section">
      <div class="page-shell split-section">
        <div>
          <p class="section-kicker">What it answers</p>
          <h2>Three relationship views. No social-media dashboard theater.</h2>
        </div>
        <div class="list-board">
          {outcomes.map(([title, body], index) => (
            <article>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <div><h3>{title}</h3><p>{body}</p></div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="how" class="content-section content-section--muted">
      <div class="page-shell">
        <div class="section-heading">
          <p class="section-kicker">How it works</p>
          <h2>Open Instagram. Run the check. Read the result.</h2>
        </div>
        <div class="steps-grid">
          {steps.map(([title, body], index) => (
            <article>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <h3>{title}</h3>
              <p>{body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="privacy" class="content-section">
      <div class="page-shell split-section">
        <div>
          <p class="section-kicker">Privacy</p>
          <h2>Small data contract. Easy to inspect.</h2>
          <p class="section-copy">WhoBack is open source and avoids an application backend. It reads only what it needs to run the extension inside your existing browser session.</p>
        </div>
        <dl class="privacy-list">
          <div><dt>Password</dt><dd>Not collected</dd></div>
          <div><dt>Backend</dt><dd>None</dd></div>
          <div><dt>Session</dt><dd>Your existing Instagram browser session</dd></div>
          <div><dt>Results</dt><dd>Local extension storage</dd></div>
        </dl>
      </div>
    </section>

    <section class="install-section">
      <div class="page-shell install-box">
        <div>
          <p class="section-kicker">Install</p>
          <h2>Get the latest release from GitHub.</h2>
          <p>Download the ZIP, extract it, open <code>chrome://extensions</code>, enable Developer mode, then choose <strong>Load unpacked</strong>.</p>
        </div>
        <a class="primary-cta" href={releaseUrl} target="_blank" rel="noreferrer">Open Releases</a>
      </div>
    </section>
  </main>

  <footer>
    <div class="page-shell footer-inner">
      <Logo />
      <span>Independent project · not affiliated with Instagram or Meta</span>
    </div>
  </footer>
</BaseLayout>
