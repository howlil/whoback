---
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/Logo.astro';
import { ProductPreview } from '../components/ProductPreview';
import { InteractiveBackground } from '../components/InteractiveBackground';
import { PageInteractions } from '../components/PageInteractions';

const releaseUrl = 'https://github.com/howlil/whoback/releases/latest';
const repoUrl = 'https://github.com/howlil/whoback';
---

<BaseLayout>
  <InteractiveBackground client:load />
  <PageInteractions client:load />

  <header class="floating-header">
    <div class="compact-nav">
      <Logo />
      <nav class="hidden items-center gap-5 text-[12px] font-medium text-muted md:flex" aria-label="Primary">
        <a href="#product">Product</a>
        <a href="#how">How it works</a>
        <a href="#privacy">Privacy</a>
        <a href={repoUrl} target="_blank" rel="noreferrer">GitHub</a>
      </nav>
      <a class="nav-cta" href={releaseUrl} target="_blank" rel="noreferrer">Get v1.1</a>
    </div>
  </header>

  <main class="site-content">
    <section class="reference-hero">
      <div class="page-shell">
        <div class="announcement">
          <span>New</span>
          <p>v1.1 adds adaptive scans and recoverable resume</p>
          <span aria-hidden="true">→</span>
        </div>

        <div class="hero-copy">
          <h1>
            See who <mark>follows you back</mark><br />
            without handing over your password.
          </h1>
          <p>
            WhoBack is a local-first Chrome extension that checks Instagram relationships from the session already open in your browser.
          </p>
          <div class="hero-actions">
            <a class="primary-cta" href={releaseUrl} target="_blank" rel="noreferrer">Download v1.1</a>
            <a class="secondary-cta" href={repoUrl} target="_blank" rel="noreferrer">View source</a>
          </div>
        </div>

        <ProductPreview client:load />
      </div>
    </section>

    <section id="product" class="feature-showcase-section" data-reveal>
      <div class="page-shell">
        <div class="showcase-heading">
          <p class="section-kicker">Product features</p>
          <h2>The relationship views that matter.</h2>
          <p>See one-way follows, mutuals, and recoverable scan progress without checking profiles one by one.</p>
        </div>

        <div class="feature-board">
          <article class="feature-tile interactive-surface feature-tile--not-back">
            <div class="feature-tile__eyebrow">
              <span class="feature-dot feature-dot--danger"></span>
              Primary view
            </div>

            <div class="feature-list-preview" aria-hidden="true">
              <div class="feature-user-row">
                <span class="feature-avatar">A</span>
                <span><strong>@alex</strong><small>Following</small></span>
                <em>Not back</em>
              </div>
              <div class="feature-user-row">
                <span class="feature-avatar">N</span>
                <span><strong>@nara</strong><small>Following</small></span>
                <em>Not back</em>
              </div>
              <div class="feature-user-row feature-user-row--muted">
                <span class="feature-avatar">M</span>
                <span><strong>@mika</strong><small>Following</small></span>
                <em>Not back</em>
              </div>
            </div>

            <div class="feature-tile__copy">
              <h3>Don&apos;t follow you back</h3>
              <p>People you follow who do not follow you back.</p>
            </div>
          </article>

          <div class="feature-stack">
            <article class="feature-tile interactive-surface feature-tile--mutual">
              <div class="feature-tile__eyebrow">
                <span class="feature-dot feature-dot--positive"></span>
                Mutual
              </div>
              <div class="feature-stat feature-stat--positive" data-count="603">603</div>
              <p>People you follow who follow you back.</p>
            </article>

            <article class="feature-tile interactive-surface feature-tile--resume">
              <div class="resume-status">
                <span class="resume-icon">↻</span>
                <div><strong>Progress saved</strong><small>616 following scanned</small></div>
              </div>
              <div class="resume-bar"><span></span></div>
              <div class="feature-tile__copy">
                <h3>Resume scan</h3>
                <p>Interrupted scans continue from saved progress instead of starting over.</p>
              </div>
            </article>
          </div>

          <article class="feature-tile interactive-surface feature-tile--fans">
            <div class="feature-tile__eyebrow">
              <span class="feature-dot feature-dot--warn"></span>
              Full scan
            </div>
            <div>
              <div class="feature-stat feature-stat--warn" data-count="828">828</div>
              <div class="feature-stat-caption">accounts</div>
            </div>
            <div class="feature-tile__copy">
              <h3>You don&apos;t follow back</h3>
              <p>Accounts that follow you while staying outside your following list.</p>
              <small>Available after a full follower scan.</small>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section id="how" class="workflow-section" data-reveal>
      <div class="page-shell">
        <div class="workflow-heading">
          <p class="section-kicker">How it works</p>
          <h2>Check your follow relationships in <mark>3 simple steps</mark></h2>
          <p>Keep Instagram signed in, run WhoBack, then inspect the relationship result.</p>
        </div>

        <div class="workflow-cards">
          <div class="workflow-step-label workflow-step-label--one">
            <span>Step 1</span>
            <svg viewBox="0 0 58 34" aria-hidden="true">
              <path d="M2 4c27 0 38 5 39 24m0 0-5-6m5 6 5-5" />
            </svg>
          </div>

          <article class="workflow-card interactive-surface">
            <div class="workflow-visual workflow-visual--instagram">
              <div class="browser-mini">
                <div class="browser-mini__bar"><span></span><span></span><span></span><b>instagram.com</b></div>
                <div class="browser-mini__body">
                  <div class="ig-avatar">Y</div>
                  <div><strong>@youraccount</strong><small>Signed in</small></div>
                  <span class="connected-pill">Connected</span>
                </div>
              </div>
            </div>
            <div class="workflow-card__copy">
              <h3>Open Instagram</h3>
              <p>Stay signed in to instagram.com in Chrome. WhoBack uses that existing browser session.</p>
            </div>
          </article>

          <div class="workflow-step-label workflow-step-label--two">
            <span>Step 2</span>
            <svg viewBox="0 0 58 34" aria-hidden="true">
              <path d="M56 30c-27 0-38-5-39-24m0 0 5 6m-5-6-5 5" />
            </svg>
          </div>

          <article class="workflow-card interactive-surface">
            <div class="workflow-visual workflow-visual--scan">
              <div class="scan-mini">
                <div class="scan-mini__header"><strong>WhoBack</strong><span>Scanning</span></div>
                <div class="scan-mini__row"><span>Following</span><strong>616</strong></div>
                <div class="scan-mini__progress"><span></span></div>
                <button type="button" tabindex="-1">Check now</button>
              </div>
            </div>
            <div class="workflow-card__copy">
              <h3>Run WhoBack</h3>
              <p>Open the extension and start a check. Progress is saved while the scan runs.</p>
            </div>
          </article>

          <div class="workflow-step-label workflow-step-label--three">
            <span>Step 3</span>
            <svg viewBox="0 0 58 34" aria-hidden="true">
              <path d="M56 4c-27 0-38 5-39 24m0 0 5-6m-5 6-5-5" />
            </svg>
          </div>

          <article class="workflow-card interactive-surface">
            <div class="workflow-visual workflow-visual--result">
              <div class="result-mini">
                <div><span>Mutual</span><strong class="result-mini__positive">603</strong></div>
                <div><span>Don&apos;t follow back</span><strong class="result-mini__danger">13</strong></div>
                <div><span>You don&apos;t follow back</span><strong class="result-mini__warn">828</strong></div>
              </div>
            </div>
            <div class="workflow-card__copy">
              <h3>View the result</h3>
              <p>Inspect mutuals and one-way follows without checking Instagram profiles individually.</p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section id="privacy" class="privacy-showcase-section" data-reveal>
      <div class="page-shell">
        <div class="privacy-heading">
          <p class="section-kicker">Privacy by design</p>
          <h2>What stays on your side.</h2>
          <p>WhoBack keeps the data flow small: use your existing Instagram session, avoid a WhoBack backend, and keep scan state in this browser.</p>
        </div>

        <div class="privacy-board">
          <article class="privacy-card privacy-card--password interactive-surface">
            <div class="privacy-visual privacy-visual--password" aria-hidden="true">
              <div class="privacy-browser">
                <div class="privacy-browser__bar"><span></span><span></span><span></span><b>instagram.com</b></div>
                <div class="privacy-browser__body">
                  <div class="privacy-account">
                    <span class="privacy-account__avatar">Y</span>
                    <div><strong>@youraccount</strong><small>Already signed in</small></div>
                  </div>
                  <div class="privacy-no-field">
                    <span>Password field</span>
                    <strong>Not here</strong>
                  </div>
                </div>
              </div>
            </div>
            <div class="privacy-card__copy">
              <h3>No password form</h3>
              <p>WhoBack does not ask you to type your Instagram password into the extension.</p>
            </div>
          </article>

          <article class="privacy-card privacy-card--session interactive-surface">
            <div class="privacy-card__eyebrow">Existing session</div>
            <div class="privacy-session-flow" aria-hidden="true">
              <span>Chrome</span>
              <i>→</i>
              <strong>Instagram</strong>
              <em>Connected</em>
            </div>
            <div class="privacy-card__copy">
              <h3>Use what is already signed in</h3>
              <p>The check runs from the Instagram session already open in your browser.</p>
            </div>
          </article>

          <article class="privacy-card privacy-card--backend interactive-surface">
            <div class="privacy-card__eyebrow">WhoBack backend</div>
            <div class="privacy-zero" aria-hidden="true">0</div>
            <div class="privacy-card__copy">
              <h3>No application backend</h3>
              <p>Relationship results do not need to pass through a WhoBack server.</p>
            </div>
          </article>

          <article class="privacy-card privacy-card--storage interactive-surface">
            <div class="privacy-storage-preview" aria-hidden="true">
              <div><span>Scan progress</span><strong>Saved</strong></div>
              <div><span>Relationship result</span><strong>Local</strong></div>
              <div><span>Resume state</span><strong>Ready</strong></div>
            </div>
            <div class="privacy-card__copy">
              <h3>Results stay in extension storage</h3>
              <p>Saved progress and relationship snapshots stay on this browser unless you remove them.</p>
            </div>
          </article>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer" data-reveal>
    <div class="page-shell">
      <section class="footer-cta interactive-surface">
        <div>
          <p class="footer-cta__eyebrow">WhoBack v1.1</p>
          <h2>Check who follows back.<br />Keep the account access with you.</h2>
          <p>Download the release ZIP, extract it, then load the folder from <code>chrome://extensions</code>.</p>
        </div>
        <div class="footer-cta__actions">
          <a class="footer-primary-cta" href={releaseUrl} target="_blank" rel="noreferrer">Download v1.1 <span>→</span></a>
          <a class="footer-secondary-cta" href={repoUrl} target="_blank" rel="noreferrer">View source</a>
        </div>
      </section>

      <div class="footer-grid">
        <div class="footer-brand">
          <Logo />
          <p>A small local-first Chrome extension for checking Instagram follow relationships without handing your password to another service.</p>
        </div>

        <nav class="footer-column" aria-label="Product">
          <strong>Product</strong>
          <a href="#product">Features</a>
          <a href="#how">How it works</a>
          <a href="#privacy">Privacy</a>
        </nav>

        <nav class="footer-column" aria-label="Project">
          <strong>Project</strong>
          <a href={repoUrl} target="_blank" rel="noreferrer">GitHub</a>
          <a href={releaseUrl} target="_blank" rel="noreferrer">Releases</a>
          <a href={repoUrl + '/blob/master/README.md'} target="_blank" rel="noreferrer">README</a>
        </nav>

        <div class="footer-install">
          <strong>Install manually</strong>
          <p>Download ZIP → extract → Developer mode → Load unpacked.</p>
          <code>chrome://extensions</code>
        </div>
      </div>

      <div class="footer-bottom">
        <span>WhoBack · open source</span>
        <span>Independent project · not affiliated with Instagram or Meta</span>
      </div>
    </div>
  </footer>

</BaseLayout>
